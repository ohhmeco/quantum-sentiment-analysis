{
  "name": "bert-shots",
  "data_dir": "data/sst2",
  "cache_dir": "data/embeddings/cache",
  "output_dir": "results",
  "embedders": [
    {
      "kind": "transformer",
      "model_name": "data/models/bert-base-uncased",
      "pooling": "mean"
    },
    {
      "kind": "sbert",
      "model_name": "data/models/all-mpnet-base-v2"
    }
  ],
  "compressors": [
    "pca",
    "pca-fisher"
  ],
  "qubits": [
    1,
    2,
    4,
    6,
    8
  ],
  "protocols": [
    {
      "protocol": "pairs",
      "n_pairs": 100
    },
    {
      "protocol": "centroid"
    },
    {
      "protocol": "superposition"
    }
  ],
  "shots": [
    16,
    64,
    256,
    1024,
    4096,
    16384,
    65536,
    262144,
    null
  ],
  "seeds": [
    0,
    1,
    2,
    3,
    4
  ],
  "center": true,
  "baselines": [],
  "retention_sample": 1000,
  "bootstrap": 0
}